   "ingredients": [
    {
     "text": "500 g kruimige aardappel",
     "name": {
      "singular": "kruimige aardappel"
     }
    },
    {
     "text": "2 preien",
     "name": {
      "singular": "prei"
     }
    },
    {
     "text": "25 g ongezouten roomboter",
     "name": {
      "singular": "ongezouten roomboter"
     }
    },
    {
     "text": "100 g diepvries tuinerwten",
     "name": {
      "singular": "diepvries tuinerwten"
     }
    },
    {
     "text": "62.5 g crème fraîche",
     "name": {
      "singular": "crème fraîche"
     }
    },
    {
     "text": "40 g pancetta",
     "name": {
      "singular": "pancetta"
     }
    },
    {
     "text": "&#189; tl gedroogde oregano",
     "name": {
      "singular": "gedroogde oregano"
     }
    },
    {
     "text": "35 ml halfvolle melk",
     "name": {
      "singular": "halfvolle melk"
     }
    },
    {
     "text": "50 g geraspte kaas voor ovengratin",
     "name": {
      "singular": "geraspte kaas voor ovengratin"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Verwarm de oven voor op 200 °C.",
     "Schil de aardappelen, snijd in gelijke stukken en kook in 15-20 min. gaar.",
     "Snijd ondertussen de prei in ringen en spoel onder koud stromend water.",
     "Verhit de boter in een grote koekenpan en bak de prei 10-12 min. op middelhoog vuur. Voeg de laatste 6 min. de tuinerwten toe.",
     "Roer de crème fraîche erdoor en breng op smaak met peper en eventueel zout. Verdeel over de ovenschaal.",
     "Bak de pancetta in een koekenpan zonder olie of boter in 5 min. krokant. Laat uitlekken op keukenpapier.",
     "Snijd de pancetta grof en meng met de oregano.",
     "Giet de aardappelen af en stamp met de melk en de rest van de boter met de pureestamper tot een gladde puree.",
     "Breng op smaak met peper en eventueel zout. Schep de puree in de spuitzak en maak toefjes op de prei.",
     "Bestrooi met de geraspte kaas.",
     "Bak ca. 25 min. in de oven tot de toefjes goudgeel zijn. Bestrooi met de pancettacrunch."
    ]
   },
