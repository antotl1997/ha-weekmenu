     "text": "3 middelgrote scharreleieren",
     "name": {
      "singular": "middelgroot scharrelei"
     }
    },
    {
     "text": "250 g iets kruimige aardappelen",
     "name": {
      "singular": "iets kruimige aardappel"
     }
    },
    {
     "text": "1 middelgrote ui",
     "name": {
      "singular": "middelgrote ui"
     }
    },
    {
     "text": "2 tenen knoflook",
     "name": {
      "singular": "knoflook"
     }
    },
    {
     "text": "5 g verse gember",
     "name": {
      "singular": "verse gember"
     }
    },
    {
     "text": "25 g ongezouten cashewnoten",
     "name": {
