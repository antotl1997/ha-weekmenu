     }
    },
    {
     "text": "2 el zonnebloemolie",
     "name": {
      "singular": "zonnebloemolie"
     }
    },
    {
     "text": "1 el curry madras specerijenmelange",
     "name": {
      "singular": "curry madras specerijenmelange"
     }
    },
    {
     "text": "200 g tomatenblokjes",
     "name": {
      "singular": "tomatenblokjes"
     }
    },
    {
     "text": "225 g diepvries gesneden bladspinazie",
     "name": {
      "singular": "diepvries gesneden bladspinazie"
     }
    },
    {
     "text": "125 ml water",
     "name": {
      "singular": "water"
