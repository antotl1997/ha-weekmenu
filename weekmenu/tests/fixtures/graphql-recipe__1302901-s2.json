    {
     "text": "600 g pastinaken",
     "name": {
      "singular": "pastinaak"
     }
    },
    {
     "text": "500 g gekookte rode bieten",
     "name": {
      "singular": "gekookte rode bieten"
     }
    },
    {
     "text": "4 el milde olijfolie",
     "name": {
      "singular": "milde olijfolie"
     }
    },
    {
     "text": "450 g jasmijnrijst",
