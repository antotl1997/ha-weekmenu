     }
    },
    {
     "text": "1 biologische citroen",
     "name": {
      "singular": "biologische citroen"
     }
    },
    {
     "text": "800 g AH Excellent hele zalmzijdes (diepvries)",
     "name": {
      "singular": "AH Excellent hele zalmzijde (diepvries)"
     }
    },
    {
