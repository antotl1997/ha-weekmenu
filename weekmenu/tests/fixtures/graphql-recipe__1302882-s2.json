   "ingredients": [
    {
     "text": "250 g iets kruimige aardappelen",
     "name": {
      "singular": "iets kruimige aardappel"
     }
    },
    {
     "text": "1 friszoete appel",
     "name": {
      "singular": "friszoete appel"
     }
    },
    {
     "text": "90 ml water",
     "name": {
      "singular": "water"
     }
    },
    {
     "text": "&#189; tl gemalen kaneel",
     "name": {
      "singular": "gemalen kaneel"
     }
    },
    {
     "text": "100 g biologische rundertartaar",
     "name": {
      "singular": "biologische rundertartaar"
     }
    },
    {
     "text": "&#189; el milde olijfolie",
     "name": {
      "singular": "milde olijfolie"
     }
    },
    {
     "text": "200 g broccoli",
     "name": {
      "singular": "broccoli"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Schil de aardappelen en kook in 20 min. gaar.",
     "Schil ondertussen de appel en snijd in blokjes van 1 cm.",
     "Breng in een steelpan de appelblokjes met het water en het kaneel aan de kook en laat op laag vuur 10 min. koken.",
     "Vorm ondertussen met vochtige handen 2 balletjes (per 2 porties) van het rundertartaar.",
     "Verhit de olijfolie in een koekenpan en bak de balletjes op middelhoog vuur in 10 min. rondom bruin en gaar.",
     "Snijd de broccoli in roosjes en kook in 6 min. gaar. Giet af en vang wat kookvocht op.",
     "Stamp de aardappelen met een pureestamper tot een smeuïge puree."
    ]
