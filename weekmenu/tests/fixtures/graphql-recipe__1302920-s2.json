   "ingredients": [
    {
     "text": "150 g winterpeen",
     "name": {
      "singular": "winterpeen"
     }
    },
    {
     "text": "2 middelgrote uien",
     "name": {
      "singular": "middelgrote ui"
     }
    },
    {
     "text": "2 el traditionele olijfolie",
     "name": {
      "singular": "traditionele olijfolie"
     }
    },
    {
     "text": "150 g diepvries biologische pompoenstukjes",
     "name": {
      "singular": "diepvries biologische pompoenstukjes"
     }
    },
    {
     "text": "500 g kruimige aardappel",
     "name": {
      "singular": "kruimige aardappel"
     }
    },
    {
     "text": "100 g rundertartaar",
     "name": {
      "singular": "rundertartaar"
     }
    },
    {
     "text": "&#189; middelgroot scharrelei",
     "name": {
      "singular": "middelgroot scharrelei"
     }
    },
    {
     "text": "&#8539; tl chilivlokken",
     "name": {
      "singular": "chilivlokken"
     }
    },
    {
     "text": "7.5 g verse peterselie",
     "name": {
      "singular": "verse peterselie"
     }
    },
    {
     "text": "35 g zuivelspread naturel",
     "name": {
      "singular": "zuivelspread naturel"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Schil de winterpeen en snijd in blokjes van 2 cm. Snijd de uien in halve ringen. Verhit de olie in een hapjespan en bak de ui 10 min.",
     "Voeg de winterpeen en pompoen toe en bak 10 min. Roer regelmatig.",
     "Schil ondertussen de aardappelen, snijd in gelijke stukken en kook in 20 min. gaar.",
     "Meng ondertussen de rundertartaar met het ei en de chilivlokken. Snijd de peterselie fijn en voeg de helft toe aan de tartaar.",
     "Meng goed en vorm er 12 gehaktballetjes van (per 4 personen).",
     "Verhit de rest van de olie in een koekenpan op middelhoog vuur en bak de gehaktballetjes in 15 min. gaar.",
     "Giet de aardappelen af en vang wat kookvocht op.",
     "Voeg de zuivelspread en eventueel wat kookvocht toe en stamp met de pureestamper tot puree. Breng op smaak met peper en eventueel zout.",
     "Meng de gebakken ui, peen en pompoen erdoor en serveer de stamppot met de gehaktballetjes en de rest van de peterselie."
    ]
   },
