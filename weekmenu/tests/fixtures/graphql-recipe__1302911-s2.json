   "ingredients": [
    {
     "text": "700 g biologische pompoen",
     "name": {
      "singular": "biologische pompoen"
     }
    },
    {
     "text": "&#189; bol knoflook",
     "name": {
      "singular": "knoflook"
     }
    },
    {
     "text": "40 ml extra vierge olijfolie",
     "name": {
      "singular": "extra vierge olijfolie"
     }
    },
    {
     "text": "20 g amandelen",
     "name": {
      "singular": "amandelen"
     }
    },
    {
     "text": "45 g Pecorino Romano",
     "name": {
      "singular": "Pecorino Romano"
     }
    },
    {
     "text": "&#188; biologische citroen",
     "name": {
      "singular": "biologische citroen"
     }
    },
    {
     "text": "3.8 g verse salie",
     "name": {
      "singular": "verse salie"
     }
    },
    {
     "text": "3.8 g platte peterselie",
     "name": {
      "singular": "platte peterselie"
     }
    },
    {
     "text": "&#189; el gedroogde tijm",
     "name": {
      "singular": "gedroogde tijm"
     }
    },
    {
     "text": "400 g koelverse gnocchi",
     "name": {
      "singular": "koelverse gnocchi"
     }
    },
    {
     "text": "50 ml kookroom",
     "name": {
      "singular": "kookroom"
     }
    },
    {
     "text": "2 mini burratine",
     "name": {
      "singular": "mini burratine"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Verwarm de oven voor op 220 °C.",
     "Halveer de pompoen, verwijder de zaden en de draderige binnenkant en leg op de snijkant op een met bakpapier beklede bakplaat.",
     "Snijd het kapje van de knoflook, besprenkel de bol met de olie en verpak in aluminiumfolie. Rooster 30-35 min. tot de pompoen zacht is.",
     "Rooster ondertussen de amandelen 3 min. in een koekenpan zonder olie of boter. Rasp de Pecorino Romano.",
     "Boen de citroen schoon, rasp de gele schil van de vrucht en pers uit.",
     "Doe de salieblaadjes, peterselie, tijm, geroosterde amandelen. 40 g kaas (per 4 personen) in de keukenmachine.",
     "Voeg hier de rest van de olie, 2 tl citroensap (per 4 personen) en wat -rasp aan toe en maal tot een grove pesto.",
     "Kook de gnocchi volgens de aanwijzingen op de verpakking. Giet af en vang 300 ml kookvocht (per 4 personen) op.",
     "Haal de bakplaat uit de oven, draai de pompoen om, verwijder de folie van de knoflook en laat beide 15-20 min. afkoelen.",
     "Verwijder de schil van de pompoen.",
     "Knijp de knoflook uit de schil en pureer met de pompoen, kookroom en de rest van de kaas in de keukenmachine tot een gladde saus.",
     "Breng op smaak met peper en eventueel zout.",
     "Verwarm de pompoensaus op laag vuur. Schep de gnocchi erdoor en verwarm 1-2 min.",
     "Meng in delen het opgevangen kookvocht erdoor tot de saus lekker romig aan de gnocchi plakt.",
     "Verdeel de gnocchi, burratines en saliepesto over borden."
    ]
