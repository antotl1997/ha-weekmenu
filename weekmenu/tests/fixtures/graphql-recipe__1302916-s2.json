   "ingredients": [
    {
     "text": "200 g champignons",
     "name": {
      "singular": "champignon"
     }
    },
    {
     "text": "30 g ongezouten roomboter",
     "name": {
      "singular": "ongezouten roomboter"
     }
    },
    {
     "text": "17.5 g 'nduja",
     "name": {
      "singular": "'nduja"
     }
    },
    {
     "text": "1 middelgrote ui",
     "name": {
      "singular": "middelgrote ui"
     }
    },
    {
     "text": "1&#189; teen knoflook",
     "name": {
      "singular": "knoflook"
     }
    },
    {
     "text": "100 g scharrelkipfilets",
     "name": {
      "singular": "scharrelkipfilet"
     }
    },
    {
     "text": "150 g risottorijst",
     "name": {
      "singular": "risottorijst"
     }
    },
    {
     "text": "&#189; bospaddenstoelenbouillontablet",
     "name": {
      "singular": "bospaddenstoelenbouillontablet"
     }
    },
    {
     "text": "600 ml kokend water",
     "name": {
      "singular": "kokend water"
     }
    },
    {
     "text": "30 g Grana Padano 32+",
     "name": {
      "singular": "Grana Padano 32+"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Snijd de champignons in kwarten. Verhit de boter in de pan op middelhoog vuur en bak de ’nduja 1 min.",
     "Voeg de champignons toe, zet het vuur hoog en bak nog 6-7 min. Schep met een schuimspaan uit de pan.",
     "Snipper ondertussen de uien en snijd de knoflook fijn. Snijd de kipfilet in blokjes van 1.5 cm.",
     "Verhit de boter in de koekenpan met het achtergebleven bakvet en bak de ui, knoflook en kip 6-7 min. op middelhoog vuur.",
     "Voeg de risottorijst toe en bak 2 min. mee.",
     "Los ondertussen het bouillonblokje op in het kokende water. Voeg een scheut bouillon toe aan de rijst en roer kort door.",
     "Herhaal dit tot de bouillon is opgenomen en de rijst gaar is. Dit duurt 20-25 min. Het mengsel hoort nog smeuïg te zijn.",
     "Breng op smaak met peper en eventueel zout.",
     "Schaaf ondertussen de kaas. Roer ⅔ van de kaas, de rest van de boter en de champignons door de risotto. Bestrooi met de rest van de kaas."
    ]
