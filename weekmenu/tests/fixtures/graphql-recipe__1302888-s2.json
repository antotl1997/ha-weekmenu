   "ingredients": [
    {
     "text": "500 g vastkokende aardappel",
     "name": {
      "singular": "vastkokende aardappel"
     }
    },
    {
     "text": "125 ml slagroom",
     "name": {
      "singular": "slagroom"
     }
    },
    {
     "text": "100 ml volle melk",
     "name": {
      "singular": "volle melk"
     }
    },
    {
     "text": "2&#189; takje verse tijm",
     "name": {
      "singular": "verse tijm"
     }
    },
    {
     "text": "1 tl mosterd",
     "name": {
      "singular": "mosterd"
     }
    },
    {
     "text": "&#189; teen knoflook",
     "name": {
      "singular": "knoflook"
     }
    },
    {
     "text": "50 g chorizoblokjes",
     "name": {
      "singular": "chorizoblokje"
     }
    },
    {
     "text": "&#189; tl chilivlokken",
     "name": {
      "singular": "chilivlokken"
     }
    },
    {
     "text": "260 g wijnzuurkool",
     "name": {
      "singular": "wijnzuurkool"
     }
    },
    {
     "text": "75 g geraspte kaas voor ovengratin",
     "name": {
      "singular": "geraspte kaas voor ovengratin"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Verwarm de oven voor op 180 °C.",
     "Snijd ondertussen de aardappelen met een kaasschaaf of mandoline in zo dun mogelijke plakjes. Kook de aardappelplakjes 5-6 min. en giet af.",
     "Breng de slagroom met de melk, de takjes tijm en de mosterd aan de kook. Breng op smaak met peper en eventueel zout.",
     "Haal van het vuur en laat 10 min. trekken.",
     "Snijd ondertussen de knoflook fijn. Verhit een koekenpan zonder olie of boter op middelhoog vuur en bak de chorizo in 5 min. knapperig.",
     "Voeg de knoflook en chilivlokken toe en bak 1 min. Laat uitlekken op keukenpapier.",
     "Knijp het vocht uit de zuurkool en meng met de kaas.",
     "Verdeel de helft van de aardappelplakjes over de bodem van de ovenschaal.",
     "Verdeel daarover de helft van het zuurkool-kaasmengsel en de helft van de chorizo.",
     "Herhaal met de rest van de aardappelen, het zuurkool-kaas mengsel en de chorizo. Druk alles heel licht aan.",
     "Verwijder de tijm uit de room en schenk het mengsel over de ovenschaal. Dek af met aluminiumfolie en bak ca. 40 min. in de oven.",
     "Ris de blaadjes van de rest van de tijm. Haal de gratin uit de oven.",
     "Verwijder de folie, bestrooi met de rest van de kaas en de tijmblaadjes en bak nog ca. 30 min. in de oven."
    ]
   },
