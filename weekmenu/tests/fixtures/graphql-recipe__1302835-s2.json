   "ingredients": [
    {
     "text": "150 g witte rijst",
     "name": {
      "singular": "witte rijst"
     }
    },
    {
     "text": "1 teen knoflook",
     "name": {
      "singular": "knoflook"
     }
    },
    {
     "text": "75 g sjalotten",
     "name": {
      "singular": "sjalot"
     }
    },
    {
     "text": "5 g verse gember",
     "name": {
      "singular": "verse gember"
     }
    },
    {
     "text": "&#189; bloemkool",
     "name": {
      "singular": "bloemkool"
     }
    },
    {
     "text": "35 g Blue Elephant Thaise gele currypasta",
     "name": {
      "singular": "Blue Elephant Thaise gele currypasta"
     }
    },
    {
     "text": "2 el zonnebloemolie",
     "name": {
      "singular": "zonnebloemolie"
     }
    },
    {
     "text": "225 g diepvries fijne tuinerwten",
     "name": {
      "singular": "diepvries fijne tuinerwten"
     }
    },
    {
     "text": "1 el kraanwater",
     "name": {
      "singular": "kraanwater"
     }
    },
    {
     "text": "&#189; rode peper",
     "name": {
      "singular": "rode peper"
     }
    },
    {
     "text": "7.5 g verse platte peterselie",
     "name": {
      "singular": "verse platte peterselie"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Kook de rijst volgens de aanwijzingen op de verpakking. Snijd ondertussen de knoflook fijn en de sjalotten in halve ringen.",
     "Schil en rasp de gember. Snijd de bloemkool in 4 mooie steaks (per 4 personen) van 1 cm dik, snijd de rest in roosjes.",
     "Meng de currypasta met de olie. Bestrijk de bloemkoolsteaks ermee en laat 15 min. staan.",
     "Verhit ondertussen de rest van de olie in een hapjespan op middelhoog vuur.",
     "Fruit hierin de gember, knoflook en sjalot met de rest van de currypasta 5 min. Schep regelmatig om.",
     "Giet de rijst af, voeg met de tuinerwten toe aan de pan en bak nog 6 min. mee op middelhoog vuur. Breng op smaak met peper en eventueel zout.",
     "Verhit ondertussen een grote koekenpan zonder boter of olie op middelhoog vuur en bak hierin de bloemkoolsteaks in 8-10 min. goudbruin.",
     "Keer halverwege. Voeg het water toe om de bloemkool gaar te stomen.",
     "Bak en stoom de bloemkoolroosjes op dezelfde manier.",
     "Snijd ondertussen het steeltje van de rode peper. Halveer de peper in de lengte, verwijder met een scherp mesje de zaadlijsten.",
     "Snijd het vruchtvlees in schuine ringetjes. Snijd de peterselie fijn.",
     "Meng de rode peper en peterselie door de rijst en serveer met de bloemkoolsteaks."
    ]
   },
