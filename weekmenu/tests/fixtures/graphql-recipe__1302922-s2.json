   "ingredients": [
    {
     "text": "500 g kruimige aardappel",
     "name": {
      "singular": "kruimige aardappel"
     }
    },
    {
     "text": "15 g ongezouten hazelnoten",
     "name": {
      "singular": "ongezouten hazelnoten"
     }
    },
    {
     "text": "2 el milde olijfolie",
     "name": {
      "singular": "milde olijfolie"
     }
    },
    {
     "text": "3 Catalaans braadworstjes",
     "name": {
      "singular": "Catalaans braadworstje"
     }
    },
    {
     "text": "1 friszoete appel",
     "name": {
      "singular": "friszoete appel"
     }
    },
    {
     "text": "&#189; middelgrote ui",
     "name": {
      "singular": "middelgrote ui"
     }
    },
    {
     "text": "&#189; teen knoflook",
     "name": {
      "singular": "knoflook"
     }
    },
    {
     "text": "300 g Chinese kolen",
     "name": {
      "singular": "Chinese kool"
     }
    },
    {
     "text": "&#189; tl komijnzaad",
     "name": {
      "singular": "komijnzaad"
     }
    },
    {
     "text": "&#189; tl paprikapoeder",
     "name": {
      "singular": "paprikapoeder"
     }
    },
    {
