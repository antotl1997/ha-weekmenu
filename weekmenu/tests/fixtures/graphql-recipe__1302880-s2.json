    {
     "text": "200 g pastinaken",
     "name": {
      "singular": "pastinaak"
     }
    },
    {
     "text": "250 g iets kruimige aardappelen",
     "name": {
      "singular": "iets kruimige aardappel"
     }
    },
    {
     "text": "&#189; el milde olijfolie",
     "name": {
      "singular": "milde olijfolie"
     }
    },
    {
     "text": "1 krokante zalmburger",
     "name": {
      "singular": "krokante zalmburger"
     }
    },
    {
     "text": "&#189; komkommer",
     "name": {
      "singular": "komkommer"
     }
    },
    {
     "text": "5 g verse dille",
     "name": {
      "singular": "verse dille"
     }
    },
    {
     "text": "3 el yoghurt Griekse stijl 0%",
     "name": {
      "singular": "yoghurt Griekse stijl 0%"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Verwarm de oven voor op 200 °C.",
     "Schil de pastinaak en de aardappelen. Snijd in blokjes van 3 cm en verdeel over een met bakpapier beklede bakplaat.",
     "Besprenkel met de olijfolie. Rooster ca. 30 min. in de oven.",
     "Bak de laatste 8-10 min. de zalmburger mee in de oven.",
     "Rasp ondertussen de komkommer grof en snijd de dille fijn.",
     "Meng de yoghurt met de komkommer en dille."
