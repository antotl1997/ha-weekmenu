   "ingredients": [
    {
     "text": "225 g diepvries tuinerwten",
     "name": {
      "singular": "diepvries tuinerwten"
     }
    },
    {
     "text": "500 g kruimige aardappel",
     "name": {
      "singular": "kruimige aardappel"
     }
    },
    {
     "text": "2 stronken witlof",
     "name": {
      "singular": "witlof"
     }
    },
    {
     "text": "3 el milde olijfolie",
     "name": {
      "singular": "milde olijfolie"
     }
    },
    {
     "text": "150 g visfrietjes",
     "name": {
      "singular": "visfrietjes"
     }
    },
    {
     "text": "3.8 g verse munt",
     "name": {
      "singular": "verse munt"
     }
    },
    {
     "text": "&#189; sjalot",
     "name": {
      "singular": "sjalot"
     }
    },
    {
     "text": "37.5 ml volle melk",
     "name": {
      "singular": "volle melk"
     }
    },
    {
     "text": "15 g ongezouten roomboter",
     "name": {
      "singular": "ongezouten roomboter"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Laat de tuinerwten ontdooien. Schil de aardappelen, snijd in gelijke stukken en kook in 20 min. gaar. Snijd ondertussen het witlof in repen.",
     "Verhit de olie in een koekenpan op middelhoog vuur en bak het witlof 5 min. Breng op smaak met peper en eventueel zout.",
     "Verhit de olie in een koekenpan op middelhoog vuur en bak de visfrietjes volgens de aanwijzingen op de verpakking. Pluk de blaadje van de takjes munt.",
     "Snipper ondertussen de sjalot, snijd de muntblaadjes fijn. Verhit de rest van de olie in een steelpan op middelhoog vuur en bak de sjalot 1 min.",
     "Voeg de tuinerwten en de munt toe en bak 6 min. Prak grof met een vork.",
     "Giet de aardappelen af en stamp met de pureestamper samen met het witlof, de melk en boter tot stamppot. Breng op smaak met peper en eventueel zout.",
     "Verdeel de stamppot met de tuinerwten en visfrietjes over borden."
    ]
