   "ingredients": [
    {
     "text": "125 g tempeh",
     "name": {
      "singular": "tempeh"
     }
    },
    {
     "text": "150 g scharrelkipfilets",
     "name": {
      "singular": "scharrelkipfilet"
     }
    },
    {
     "text": "1&#189; el ketjap manis",
     "name": {
      "singular": "ketjap manis"
     }
    },
    {
     "text": "&#189; el sambal oelek",
     "name": {
      "singular": "sambal oelek"
     }
    },
    {
     "text": "205 ml water",
     "name": {
      "singular": "water"
     }
    },
    {
     "text": "150 g witte snelkookrijst",
     "name": {
      "singular": "witte snelkookrijst"
     }
    },
    {
     "text": "450 g diepvries nasi-bamigroente",
     "name": {
      "singular": "diepvries nasi-bamigroente"
     }
    },
    {
     "text": "1 rode ui",
     "name": {
      "singular": "rode ui"
     }
    },
    {
     "text": "1&#189; el natuurazijn",
     "name": {
      "singular": "natuurazijn"
     }
    }
   ],
   "preparation": {
    "steps": [
     "Verwarm de oven voor op 200 °C.",
     "Snijd de tempeh in repen van 1 cm en de kip in dunne repen en meng in een kom.",
     "Roer de ketjap los met de sambal en het water en meng door het kip-tempehmengsel.",
     "Meng in de braadslede de rijst met de bevroren nasi-bamigroente en het water en verdeel over ⅔ van de braadslede.",
     "Verdeel het kip-tempehmengsel over de andere kant. Breng op smaak met peper en eventueel zout en dek af met aluminiumfolie.",
     "Bak ca. 40 min. in de oven tot de rijst gaar is.",
     "Snijd ondertussen de rode ui in flinterdunne halve ringen.",
     "Doe in een kom met de azijn en de rest van het water. Breng op smaak met peper en laat staan tot gebruik.",
     "Haal de braadslede uit de oven en laat nog 5 min. afgedekt staan. Verdeel de rode ui erover."
    ]
   },
